{
  "name": "cw-handsoff-sys",
  "version": "0.6.0",
  "private": true,
  "description": "Local multi-AI engineering workbench with role-based delegation.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "package:win": "electron-builder --win portable",
    "icon:build": "electron scripts/build-icon.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:timer:live": "node scripts/simulate-timer.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.agent.controltower",
    "productName": "CW_Handsoff_sys",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/app.ico"
    },
    "directories": {
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "productName": "CW_Handsoff_sys"
}
